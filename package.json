{
  "name": "cmu-web-fencepost",
  "version": "0.2.3",
  "private": true,
  "description": "Link previews for Carnegie Mellon websites: the image and the Open Graph tags.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "preview:kilt": "sh -c 'k=${KILT_DIR:-../cmu-web-kilt}; [ -f \"$k/tools/preview.mjs\" ] || { echo \"No Web Kilt checkout with the preview proxy at $k (set KILT_DIR)\" >&2; exit 1; }; exec node \"$k/tools/preview.mjs\" --proxy http://localhost:3000'",
    "gallery": "tsx src/gallery.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:node": "node scripts/check-node-version.mjs",
    "check": "npm run check:node && npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:docs && npm run check:wordpress && npm run check:action",
    "docs": "node scripts/domains-table.mjs",
    "check:docs": "node scripts/domains-table.mjs --check",
    "check:wordpress": "node scripts/check-wordpress.mjs",
    "check:action": "node scripts/check-action.mjs",
    "shoot": "tsx src/cli.ts"
  },
  "license": "BSD-3-Clause",
  "allowScripts": {
    "esbuild": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@j178/prek": "^0.5.11",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
